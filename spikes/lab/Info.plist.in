<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>BlendLab</string>
	<key>CFBundleIdentifier</key>
	<string>app.blend.lab</string>
	<key>CFBundleName</key>
	<string>Blend Lab</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Blend Lab records from Blend's virtual microphones to test them.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Blend Lab captures audio from other apps to test app sources.</string>
</dict>
</plist>
